datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Theme {
  id                  String   @id
  title               String
  description         String
  orgLayer            String
  miniViewLayers      Json
  primaryColor        String
  secondaryColor      String
  backgroundColor     String
  navbarColor         String
  textColor           String
  darkPrimaryColor    String?
  darkSecondaryColor  String?
  darkBackgroundColor String?
  darkTextColor       String?
  darkNavbarColor     String?
  games               Json
  navbarItems         Json
  labels              Json
  layerMetadata       Json
  
  entities            Entity[]

  @@map("Theme") // Matches exact casing in database
}

model Entity {
  id                 String             @id
  themeId            String
  name               String
  type               String
  status             String
  isStandalone       Boolean            @default(false)
  image              Json
  metadata           Json

  theme              Theme              @relation(fields: [themeId], references: [id], onDelete: Cascade)
  connections        EntityConnection[] @relation("SourceEntity")
  targetConnections  EntityConnection[] @relation("TargetEntity")

  @@index([themeId])
  @@map("Entity") // Matches exact casing in database
}

model EntityConnection {
  id             String @id @default(cuid())
  themeId        String
  sourceEntityId String
  targetEntityId String
  metadata       Json

  sourceEntity   Entity @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity   Entity @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("EntityConnection") // Matches exact casing in database
}

model GameSetting {
  id           String @id @default(cuid())
  themeId      String
  gameName     String @default("guesswho")
  gameSettings Json

  @@unique([themeId, gameName])
  @@map("GameSetting") // Matches exact casing in database
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relation to user's saved items, favorites, etc.
  savedItems   UserSavedItem[]

  @@map("User") // Matches exact casing in database
}

model UserSavedItem {
  id        String   @id @default(cuid())
  userId    String
  themeId   String?  // Plain string field, no relation to theme
  type      String   // e.g. "sorter", "favorites"
  name      String   // Custom name chosen by the user (e.g. "My favorite run")
  data      Json     // Stores the full save state / payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to user only
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, themeId])
  @@map("UserSavedItem") // Matches exact casing in database
}